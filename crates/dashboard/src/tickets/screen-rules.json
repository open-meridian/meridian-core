     "names": [
      "system",
      "assistant",
      "user",
      "instructions",
      "instruction"
     ]
    }
   ],
   "vendor_text": "withhold",
   "ticket": "suspect",
   "agent_write": "hold",
   "cases": [
    "RT29",
    "RT36"
