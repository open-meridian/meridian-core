{
 "about": "The screen rules, one canonical table (the v26 plan's question 239, ruled 2026-10-17): each rule's name as every surface answers it, its matchers, the side it takes on each surface, and the corpus cases it pins. Vendored into meridian-platform, meridian-core and meridian-cli by each one's make prompt-attacks, and loaded at build or start-up instead of hand-ported code; check-vendored-corpus holds the copies equal, and the corpus replays in all three.",
 "normalise": "NFKC, case-folded, every run of whitespace one space, leading and trailing whitespace dropped; a match is reported on the original text by character",
 "matcher_kinds": {
  "words": "any phrase of `phrases`, or of the named list `list`, standing as a whole word or phrase (\\b...\\b where its end is a word character); `unless_after` names a list of terms the matched word is exempt after, one space between",
  "anywhere": "any string of `strings`, anywhere",
  "within": "a word of `first`, then within `gap` characters a word of `then`",
  "followed_by": "a word of `first`, one space, then a word or phrase of `then`",
  "marker": "a word of `names`, an optional space, then a colon, not after a word character",
  "tag": "`<`, an optional space, an optional `/`, an optional space, a name of `names`, an optional space, `>`",
  "opener": "the text starting with a word of `words`, an optional space, then a colon",
  "closers": "a quote (\" or '), then two closing brackets (} or ]), each after an optional space",
  "link_after": "a word of `first`, then within `gap` characters http://, https://, www. or an e-mail address",
  "tool_shape": "an `{instance}__{name}` tool: letters, digits and hyphens, `__`, then a word, standing whole",
  "surface_tools": "a tool name the reading surface itself serves, by its own tool list (core's deployment tools, the platform's MCP tools): each surface's own, generated from its tool registry, never copied here",
  "clause_verb": "a verb of `verbs` opening a clause -- at the start, after . ! ? ; : , - ( [ or after a word of `leads` -- then one space and a word of `objects`",
  "joined": "a word of `first`, a separator of `between`, then a word of `then`, as one phrase"
 },
 "surfaces": {
  "vendor_text": "a plugin's documentation and its declaration's vendor text, at the platform's build intake, the deployment's upload and meridian plugin check (ruling 176): refuse refuses the build or the upload naming the rule and fails plugin check; withhold keeps it, shown to people marked Screened and withheld from agents, and plugin check reports advice",
  "ticket": "a ticket's title and seen text, and each note, in the deployment (W6.21 to W6.23): suspect files it held, its tools answering the matched rules and never the text until a person releases it",
  "agent_write": "a description, note or source an agent writes through the platform's MCP (the curator's X8): hold keeps the write as a proposal for a person instead of making it"
 },
 "contract_terms": [
  "allocation instruction",
  "allocation instructions",
  "trading instruction",
  "trading instructions",
  "settlement instruction",
  "settlement instructions",
  "execution instruction",
  "execution instructions",
  "handling instruction",
  "handling instructions"
 ],
 "registry_tools": [
  "search_plugins",
  "get_plugin",
  "search_plugin_documentation",
  "read_listing_documentation",
  "read_plugin_build",
  "set_organisation_namespace",
  "set_organisation_slug",
  "check_publisher_lei",
  "record_court_action",
  "get_plugin_usage",
  "list_repositories",
  "get_verified_details",
  "star_plugin",
  "unstar_plugin",
  "list_signing_keys",
  "set_plugin_attributes",
  "withdraw_version",
  "list_plugin_reviews",
  "get_plugin_review",
  "propose_review",
  "propose_pull",
  "list_publishers",
  "list_copyright_notices",
  "get_copyright_notice",
  "record_copyright_notice",
  "record_counter_notice",
  "propose_copyright_pull",
  "propose_restore",
  "get_copyright_agent",
  "dashboard__search_registry_plugins",
  "dashboard__read_registry_plugin",
  "dashboard__install_plugin",
  "dashboard__update_plugin",
  "dashboard__acknowledge_pull",
  "dashboard__read_registries",
  "dashboard__set_reports_plugin_usage"
 ],
 "rules": [
  {
   "name": "override",
   "regex": "\\b(?:ignore|disregard|forget|override|bypass)\\b.{0,40}?\\b(?:instructions?|rules?|prompts?|directions?|procedures?|guidelines?)\\b",
   "matchers": [
    {
     "kind": "within",
     "first": [
      "ignore",
      "disregard",
      "forget",
      "override",
      "bypass"
     ],
     "then": [
      "instruction",
      "instructions",
      "rule",
      "rules",
      "prompt",
      "prompts",
      "direction",
      "directions",
      "procedure",
      "procedures",
      "guideline",
      "guidelines"
     ],
     "gap": 40
    }
   ],
   "vendor_text": "refuse",
   "ticket": "suspect",
   "agent_write": "hold",
   "cases": [
    "RT1",
    "RT9",
    "RT19",
    "RT44"
   ]
  },
  {
   "name": "role marker",
   "regex": "(?:^|[^a-z0-9_])(?:system|assistant|developer|user|human)\\s*:",
   "matchers": [
    {
     "kind": "marker",
     "names": [
      "system",
      "assistant",
      "developer",
      "user",
      "human"
