{
  "_note": "Two things to know. A query is a call and a call is gated by the publish grant, so a role that only reads still needs its query topics listed under publish. And a plugin's role and each of its tags are looked up in this one table and unioned, so a tag is an entry here like any other; giving a tag the same name as a role merges them silently.",
  "roles": {
    "custody": {
      "publish": [
        "platform.street.command.record-statement",
        "platform.street.command.record-holding",
        "platform.reference.query.resolve-identifier",
        "platform.reference.query.resolve-instrument",
        "platform.reference.event.instrument-missing",
        "platform.custody.*.event.sync-status"
      ],
      "subscribe": [
        "platform.reference.event.instrument-applied"
      ]
    },
    "admin": {
      "publish": [
        "platform.street.query.list-custodial-positions",
        "platform.reference.query.resolve-identifier",
        "platform.reference.query.resolve-instrument",
        "platform.config.event.person-signed-in",
        "platform.config.query.access-records",
        "platform.config.command.redeem-claim-code",
        "platform.config.command.define-account",
        "platform.config.command.close-account",
        "platform.config.command.link-external-account",
        "platform.config.command.define-user-group",
        "platform.config.command.define-account-group",
        "platform.config.command.define-access-group",
        "platform.config.command.grant-permission",
        "platform.config.command.withdraw-permission",
        "platform.config.command.set-plugin-settings",
        "platform.config.command.send-diagnostic-bundle"
      ],
      "subscribe": [
        "platform.street.event.*",
        "platform.reference.event.*",
        "platform.custody.*.event.sync-status",
        "platform.deployment.event.plugin-report",
        "platform.config.event.unlinked-external-accounts"
      ]
    },
    "reporting": {
      "publish": [
        "platform.street.query.list-custodial-positions"
      ],
      "subscribe": [
        "platform.street.event.custodial-position-updated"
      ]
    }
  }
}
