# syntax=docker/dockerfile:1
#
# Build and test the Rust workspace.
#
# The host is not asked for a Rust toolchain. Everything runs here, at a pinned
# version, so a contributor needs only Docker and every check is reproducible.
#
# Source is copied rather than bind-mounted: mounting a host directory into the
# VM raced, and cargo intermittently failed to create its own target directory.

ARG RUST_VERSION=1.90
# The runtime image, for the settings pages' server below: the dashboard's
# base and the kit the image carries. Built first by the target that uses it.
ARG RUNTIME_IMAGE=meridian-runtime:local
# Where the settings pages' server takes its executable from: the
# settings-binary-image stage below, which compiles it, or an image of it
# already built (make passes $(SETTINGS_BINARY_IMAGE)), from which nothing
# compiles (ruling 1068).
ARG SETTINGS_BINARY=settings-binary-image

# The tools CI keeps in GitHub's cache (tools/ci-tools.txt), which its jobs
# give as the `fetched` build context (`--build-context fetched=...`); empty
# here, where every build but CI's fetches each itself. Either way each is
# checked against its digest before it is used.
FROM scratch AS fetched

FROM rust:${RUST_VERSION}-slim-bookworm AS toolchain
# tzdata: the instrument store reads a spot-date rule's cut in its zone from
# the host's tz database (contract v22, W3.20), and its tests do too.
# lld: the linker on arm64 too (ruling 1069, 449). Rust links with its own
# LLD on x86_64 Linux since 1.90; on aarch64 it still asks the C compiler,
# whose default is bfd, and a Mac's gate runs here on aarch64.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates tzdata lld curl \
 && rm -rf /var/lib/apt/lists/*
# Every download here is retried with backoff: GitHub's release downloads
# answer 504 at times (2026-11-08, one merge-queue run lost each time), and a
# tool that could not be fetched is no verdict on the change. What was
# fetched is still checked against its published digest, as before.
#
# sccache (ruling 1104; step 3b part 4): the compiles CI runs from cold
# fetch what an earlier run compiled from GitHub's cache, keyed by what
# rustc is given. A pinned release, checked against its published digest.
# Used only where a build is given GitHub's cache token, and only as a
# BuildKit secret (tools/with-sccache.sh): a build without one -- every
# laptop's -- compiles as it always has, and the token is in no layer.
ARG TARGETARCH
ARG SCCACHE_VERSION=0.18.0
ARG SCCACHE_SHA256_AMD64=45f1447fbe231e3037bde351ef70677dd212216c8d62ae7ca409fecc4d6acc89
ARG SCCACHE_SHA256_ARM64=2b3284d5da3b46a47dc4229e75bb7b88ac4aa99c8d754fb7d2f84997e5a4354a
RUN --mount=type=bind,from=fetched,target=/fetched \
    case "${TARGETARCH}" in \
      amd64) ARCH=x86_64; SUM="${SCCACHE_SHA256_AMD64}" ;; \
      arm64) ARCH=aarch64; SUM="${SCCACHE_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && file="sccache-v${SCCACHE_VERSION}-${ARCH}-unknown-linux-musl.tar.gz" \
 && { cp "/fetched/$file" /tmp/sccache.tgz 2>/dev/null \
      || curl -fsSL --retry 6 --retry-all-errors --retry-delay 10 --retry-max-time 300 -o /tmp/sccache.tgz \
           "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/$file"; } \
 && echo "${SUM}  /tmp/sccache.tgz" | sha256sum -c - \
 && tar -xzf /tmp/sccache.tgz -C /tmp \
 && mv /tmp/sccache-*/sccache /usr/local/bin/sccache \
 && rm -rf /tmp/sccache.tgz /tmp/sccache-*
COPY tools/with-sccache.sh /usr/local/bin/with-sccache
# Smaller build caches on the VM's one disk, which the gates and the dev
# deployment share: no incremental state, which a fresh build never reuses
# across stages, and line tables alone for debug builds and tests, so a
# stack trace stays readable at about half the artifacts' size.
ENV CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=line-tables-only \
    CARGO_PROFILE_TEST_DEBUG=line-tables-only \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C link-arg=-fuse-ld=lld"
WORKDIR /w
# Every cargo run against the shared target cache, wrapped: each source's time
# set from what the cache last saw of its content, so another checkout's build
# is never taken for this one's (tools/fresh-sources.sh).
COPY tools/fresh-sources.sh /usr/local/bin/fresh-sources

# The workspace's sources over the toolchain: every stage that compiles
# starts here. What needs no source (nextest, below) starts from the
# toolchain, so a change to a crate never downloads it again.
FROM toolchain AS base
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
# The contract the sidecar and the broker grant from, compiled in
# (decisions/020), and what the tests assert against: the one the deployment
# actually runs, rather than a copy of it that drifts in silence.
COPY deploy/ deploy/

# The gate's one compile of the workspace. Every debug binary and every test
# binary the gates run is compiled here, once, and the stages and images that
# need them copy them rather than compile again (the release binaries are the
# runtime image's own, in Dockerfile). The cargo caches are named, so the gate
# frees every other build cache between its stages and keeps these
# (tools/gate.py); Dockerfile's release build uses the same ids, so there is
# one set of them to keep, not two.
FROM base AS check
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    --mount=type=secret,id=gha-runtime-token,required=false \
    --mount=type=secret,id=gha-results-url,required=false \
    --mount=type=secret,id=gha-cache-url,required=false \
    --mount=type=secret,id=gha-cache-v2,required=false \
    with-sccache fresh-sources cargo build --workspace --locked

# cargo-nextest (ruling 1104; step 3b part 4), which run-tests runs every
# test binary under: each test its own process, its result in JUnit (the
# checks' test reports), a flaky one -- failed, then passed on its retry --
# named as such. A pinned release, checked against its published digest;
# the compile below and the fast gate's tests copy it from here.
FROM toolchain AS nextest
ARG TARGETARCH
ARG NEXTEST_VERSION=0.9.149
ARG NEXTEST_SHA256_AMD64=d65c7f14bcb5c1566d1ecd534c5da8dedb81ba58586e478b0ab81c877d2bd8ad
ARG NEXTEST_SHA256_ARM64=533c9b431c2bb1dcb216e02e474263db0cdcd556373b72cc34830fb417058a6b
RUN --mount=type=bind,from=fetched,target=/fetched \
    case "${TARGETARCH}" in \
      amd64) ARCH=x86_64; SUM="${NEXTEST_SHA256_AMD64}" ;; \
      arm64) ARCH=aarch64; SUM="${NEXTEST_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && file="cargo-nextest-${NEXTEST_VERSION}-${ARCH}-unknown-linux-musl.tar.gz" \
 && { cp "/fetched/$file" /tmp/nextest.tgz 2>/dev/null \
      || curl -fsSL --retry 6 --retry-all-errors --retry-delay 10 --retry-max-time 300 -o /tmp/nextest.tgz \
           "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${NEXTEST_VERSION}/$file"; } \
 && echo "${SUM}  /tmp/nextest.tgz" | sha256sum -c - \
 && tar -xzf /tmp/nextest.tgz -C /usr/local/bin \
 && rm /tmp/nextest.tgz

# Every test binary: each crate's unit tests and every integration test, in
# one invocation with the whole workspace's features, as `test` always built
# them. Kept, with a manifest saying whose each is, in /tests -- with the
# workspace's binaries a test starts, and only those, linked back where it
# finds them (the runtime's waiting tests, by CARGO_BIN_EXE_<name>) -- the only part of the target
# directory this image holds; tools/run-tests.sh runs them as `cargo test`
# would. test-store, test-broker and test-directory run this image
# beside their services (docker-compose.yaml's `tests`), where each used to
# compile the workspace again from nothing in a container's own layer.
FROM check AS compile
COPY --from=nextest /usr/local/bin/cargo-nextest /usr/local/bin/cargo-nextest
COPY .config/ .config/
COPY tools/run-tests.sh /usr/local/bin/run-tests
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    --mount=type=secret,id=gha-runtime-token,required=false \
    --mount=type=secret,id=gha-results-url,required=false \
    --mount=type=secret,id=gha-cache-url,required=false \
    --mount=type=secret,id=gha-cache-v2,required=false \
    with-sccache fresh-sources cargo test --workspace --locked --no-run --lib --test '*' \
      --message-format=json-render-diagnostics >/tmp/compiled.json \
 && run-tests collect </tmp/compiled.json \
 && rm /tmp/compiled.json \
 && with-sccache cargo nextest list --workspace --locked --lib --test '*' --list-type binaries-only \
      --message-format json >/tests/binaries.json \
 && cargo metadata --format-version 1 --locked \
      --filter-platform "$(rustc -vV | sed -n 's/^host: //p')" >/tests/cargo-metadata.json
RUN run-tests link

# The unit tests, and the integration tests that stand up their own world
# in-process, are run from this image by `make test` (`run-tests --workspace
# --lib`, and the runtime's wiring module on its own run), as the services'
# suites are: the image is built once and every stage that needs a test
# binary runs it (ruling 1068), rather than a build stage of its own running
# them again on top of it.
#
# `--lib` alone was the whole of that run until the runtime's wiring test
# existed and never ran. An integration test that no target names is not a
# slower test, it is an absent one, so check-test-targets refuses a tests/ file
# that no make target reaches.
#
# The rest need services a build stage has none of: the two store suites want
# Postgres (`make test-store`), and end_to_end and outage want a platform to
# prove themselves against (`make demo`). A lightweight in-process substitute is
# deliberately not offered for any of them, so a store or a platform client that
# behaves differently in development cannot exist.

# Clippy is an analysis, not a build: it checks every target, tests included,
# with nothing to copy from the compile above, and keeps what it checks in the
# same target cache so a second run checks only what changed.
FROM base AS lint
RUN rustup component add clippy rustfmt
RUN cargo fmt --all -- --check
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo clippy --workspace --locked --all-targets -- -D warnings

# The fast pre-push gate's Rust (make pre-push; accepted 2026-11-07: CI and
# the merge queue are the authority for main, local is fast and targeted):
# formatting, clippy and the debug build of the whole workspace, as lint and
# check run them -- over the same cargo caches, with the same features, so on
# a warm cache cargo redoes only the crates a change touched and those
# depending on them -- and then the unit tests of the crates the branch
# changed and of every crate depending on them, FAST_TESTS, a nextest
# filterset the Makefile has from tools/pre_push.py. The test binaries are
# compiled for the whole workspace, as `cargo test --workspace --lib` would,
# so a selection never changes the features a dependency is built with, and
# only the selection's run. Each step a layer of its own: a tree already
# checked is answered from the build cache.
FROM base AS fast
RUN rustup component add clippy rustfmt
COPY --from=nextest /usr/local/bin/cargo-nextest /usr/local/bin/cargo-nextest
COPY .config/ .config/
RUN cargo fmt --all -- --check
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo clippy --workspace --locked --all-targets -- -D warnings
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo build --workspace --locked
ARG FAST_TESTS=
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    if [ -n "$FAST_TESTS" ]; then \
      fresh-sources cargo nextest run --workspace --locked --lib --no-tests=pass -E "$FAST_TESTS"; \
    fi

# Published vulnerabilities in anything the workspace links, from the RustSec
# advisory database, read fresh on every run. A prebuilt cargo-deny at a pinned
# release rather than `cargo install`, which would compile it every time the
# cache is cold. deny.toml says what is checked and records every exception
# with its reason.
FROM base AS advisories
ARG CARGO_DENY_VERSION=0.20.2
# The release's published digests (its .sha256 assets).
ARG CARGO_DENY_SHA256_AMD64=9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f
ARG CARGO_DENY_SHA256_ARM64=995c82be0defc7a025cae49a2aa2644ce8245c9a3318fc4103907c6a285e8c7d
ARG TARGETARCH
RUN --mount=type=bind,from=fetched,target=/fetched \
    case "${TARGETARCH}" in \
      amd64) ARCH=x86_64; SUM="${CARGO_DENY_SHA256_AMD64}" ;; \
      arm64) ARCH=aarch64; SUM="${CARGO_DENY_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
 && file="cargo-deny-${CARGO_DENY_VERSION}-${ARCH}-unknown-linux-musl.tar.gz" \
 && { cp "/fetched/$file" /tmp/deny.tgz 2>/dev/null \
      || curl -fsSL --retry 6 --retry-all-errors --retry-delay 10 --retry-max-time 300 -o /tmp/deny.tgz \
           "https://github.com/EmbarkStudios/cargo-deny/releases/download/${CARGO_DENY_VERSION}/$file"; } \
 && echo "${SUM}  /tmp/deny.tgz" | sha256sum -c - \
 && tar -xzf /tmp/deny.tgz -C /tmp \
 && mv /tmp/cargo-deny-*/cargo-deny /usr/local/bin/ \
 && rm -rf /tmp/deny.tgz /tmp/cargo-deny-*
COPY deny.toml ./
# The database fetched first, retried with backoff, and said plainly when it
# cannot be (the Makefile tells that from a finding); then checked offline.
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    for i in 1 2 3 4 5 6; do \
      cargo deny --locked fetch && break; \
      [ "$i" = 6 ] && { echo "advisories: the advisory database and the index could not be fetched, six times over: a network failure, not a finding" >&2; exit 3; }; \
      sleep 10; \
    done \
 && cargo deny --offline check advisories

# The dashboard's unit-test binary alone, for the Settings pages below: the
# compile's own invocation again over the same cache, so nothing compiles
# again, and the one executable kept -- not compile's every test binary,
# which the gate frees before e2e-settings-page runs (gate-drop-tests-image).
FROM check AS settings-binary
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo test --workspace --locked --no-run --lib --test '*' \
      --message-format=json-render-diagnostics >/tmp/compiled.json \
 && exe=$(sed -n 's/.*"manifest_path":"[^"]*\/crates\/dashboard\/Cargo.toml".*"target":{"kind":\["lib"\].*"executable":"\([^"]*\)".*/\1/p' /tmp/compiled.json | head -1) \
 && test -n "$exe" \
 && cp "$exe" /settings-page \
 && rm /tmp/compiled.json

# The one executable on its own, an image of nothing else (make
# settings-binary-image): what CI's compile job pushes beside the test
# binaries, so the settings-page stage puts it on the runtime image without
# compiling (ruling 1068).
FROM scratch AS settings-binary-image
COPY --from=settings-binary /settings-page /settings-page

# Where the executable is taken from (SETTINGS_BINARY, above).
FROM ${SETTINGS_BINARY} AS settings-binary-from

# A plugin's Settings pages served for a real browser (make e2e-settings-page):
# the dashboard's unit-test binary, whose ignored server
# (crates/dashboard/src/admin/tests/served.rs) stands up its own world in-process,
# on the runtime image so it serves the kit that image carries.
FROM ${RUNTIME_IMAGE} AS settings-page
COPY --from=settings-binary-from /settings-page /usr/local/bin/settings-page
ENTRYPOINT ["settings-page", "--ignored", "--exact", "admin::tests::served::serve_a_plugins_settings_pages_for_a_browser", "--nocapture"]
