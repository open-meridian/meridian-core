# syntax=docker/dockerfile:1
#
# Build and test the Rust workspace.
#
# The host is not asked for a Rust toolchain. Everything runs here, at a pinned
# version, so a contributor needs only Docker and every check is reproducible.
#
# Source is copied rather than bind-mounted: mounting a host directory into the
# VM raced, and cargo intermittently failed to create its own target directory.

ARG RUST_VERSION=1.90

FROM rust:${RUST_VERSION}-slim-bookworm AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /w
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
# The runtime's wiring test asserts against the grant table the deployment
# actually ships, rather than a copy of it that drifts in silence.
COPY deploy/ deploy/

FROM base AS check
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/w/target \
    cargo build --workspace --locked

# Everything that needs nothing but a toolchain: the unit tests, and the
# integration tests that stand up their own world in-process.
#
# `--lib` alone was the whole of this stage until the runtime's wiring test
# existed and never ran. An integration test that no target names is not a
# slower test, it is an absent one, so check-test-targets refuses a tests/ file
# that no make target reaches.
#
# The rest need services a build stage has none of: the two store suites want
# Postgres (`make test-store`), and end_to_end and outage want a platform to
# prove themselves against (`make demo`). A lightweight in-process substitute is
# deliberately not offered for any of them, so a store or a platform client that
# behaves differently in development cannot exist.
FROM base AS test
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/w/target \
    cargo test --workspace --locked --lib --test wiring

FROM base AS lint
RUN rustup component add clippy rustfmt
RUN cargo fmt --all -- --check
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/w/target \
    cargo clippy --workspace --locked --all-targets -- -D warnings

# Published vulnerabilities in anything the workspace links, from the RustSec
# advisory database, read fresh on every run. A prebuilt cargo-deny at a pinned
# release rather than `cargo install`, which would compile it every time the
# cache is cold. deny.toml says what is checked and records every exception
# with its reason.
FROM base AS advisories
ARG CARGO_DENY_VERSION=0.20.2
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) ARCH=x86_64 ;; \
      arm64) ARCH=aarch64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /tmp/deny.tgz \
      "https://github.com/EmbarkStudios/cargo-deny/releases/download/${CARGO_DENY_VERSION}/cargo-deny-${CARGO_DENY_VERSION}-${ARCH}-unknown-linux-musl.tar.gz" \
 && tar -xzf /tmp/deny.tgz -C /tmp \
 && mv /tmp/cargo-deny-*/cargo-deny /usr/local/bin/ \
 && rm -rf /tmp/deny.tgz /tmp/cargo-deny-*
COPY deny.toml ./
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo deny --locked check advisories

