# syntax=docker/dockerfile:1
#
# Build and test the Rust workspace.
#
# The host is not asked for a Rust toolchain. Everything runs here, at a pinned
# version, so a contributor needs only Docker and every check is reproducible.
#
# Source is copied rather than bind-mounted: mounting a host directory into the
# VM raced, and cargo intermittently failed to create its own target directory.

ARG RUST_VERSION=1.90
# The runtime image, for the settings pages' server below: the dashboard's
# base and the kit the image carries. Built first by the target that uses it.
ARG RUNTIME_IMAGE=meridian-runtime:local

FROM rust:${RUST_VERSION}-slim-bookworm AS base
# tzdata: the instrument store reads a spot-date rule's cut in its zone from
# the host's tz database (contract v22, W3.20), and its tests do too.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*
# Smaller build caches on the VM's one disk, which the gates and the dev
# deployment share: no incremental state, which a fresh build never reuses
# across stages, and line tables alone for debug builds and tests, so a
# stack trace stays readable at about half the artifacts' size.
ENV CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=line-tables-only \
    CARGO_PROFILE_TEST_DEBUG=line-tables-only
WORKDIR /w
# Every cargo run against the shared target cache, wrapped: each source's time
# set from what the cache last saw of its content, so another checkout's build
# is never taken for this one's (tools/fresh-sources.sh).
COPY tools/fresh-sources.sh /usr/local/bin/fresh-sources
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
# The contract the sidecar and the broker grant from, compiled in
# (decisions/020), and what the tests assert against: the one the deployment
# actually runs, rather than a copy of it that drifts in silence.
COPY deploy/ deploy/

# The gate's one compile of the workspace. Every debug binary and every test
# binary the gates run is compiled here, once, and the stages and images that
# need them copy them rather than compile again (the release binaries are the
# runtime image's own, in Dockerfile). The cargo caches are named, so the gate
# frees every other build cache between its stages and keeps these
# (tools/gate.py); Dockerfile's release build uses the same ids, so there is
# one set of them to keep, not two.
FROM base AS check
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo build --workspace --locked

# Every test binary: each crate's unit tests and every integration test, in
# one invocation with the whole workspace's features, as `test` always built
# them. Kept, with a manifest saying whose each is, in /tests -- with the
# workspace's binaries a test starts, and only those, linked back where it
# finds them (the runtime's waiting tests, by CARGO_BIN_EXE_<name>) -- the only part of the target
# directory this image holds; tools/run-tests.sh runs them as `cargo test`
# would. test-store, test-broker and test-directory run this image
# beside their services (docker-compose.yaml's `tests`), where each used to
# compile the workspace again from nothing in a container's own layer.
FROM check AS compile
COPY tools/run-tests.sh /usr/local/bin/run-tests
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo test --workspace --locked --no-run --lib --test '*' \
      --message-format=json-render-diagnostics >/tmp/compiled.json \
 && run-tests collect </tmp/compiled.json \
 && rm /tmp/compiled.json
RUN run-tests link

# Everything that needs nothing but a toolchain: the unit tests, and the
# integration tests that stand up their own world in-process.
#
# `--lib` alone was the whole of this stage until the runtime's wiring test
# existed and never ran. An integration test that no target names is not a
# slower test, it is an absent one, so check-test-targets refuses a tests/ file
# that no make target reaches.
#
# The rest need services a build stage has none of: the two store suites want
# Postgres (`make test-store`), and end_to_end and outage want a platform to
# prove themselves against (`make demo`). A lightweight in-process substitute is
# deliberately not offered for any of them, so a store or a platform client that
# behaves differently in development cannot exist.
FROM compile AS test
# The runtime's wiring module on its own run: a filter after -- applies to
# every binary a run selects, the unit tests' too.
RUN run-tests --workspace --lib \
 && run-tests -p meridian-runtime --test it -- wiring::

# Clippy is an analysis, not a build: it checks every target, tests included,
# with nothing to copy from the compile above, and keeps what it checks in the
# same target cache so a second run checks only what changed.
FROM base AS lint
RUN rustup component add clippy rustfmt
RUN cargo fmt --all -- --check
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo clippy --workspace --locked --all-targets -- -D warnings

# Published vulnerabilities in anything the workspace links, from the RustSec
# advisory database, read fresh on every run. A prebuilt cargo-deny at a pinned
# release rather than `cargo install`, which would compile it every time the
# cache is cold. deny.toml says what is checked and records every exception
# with its reason.
FROM base AS advisories
ARG CARGO_DENY_VERSION=0.20.2
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) ARCH=x86_64 ;; \
      arm64) ARCH=aarch64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /tmp/deny.tgz \
      "https://github.com/EmbarkStudios/cargo-deny/releases/download/${CARGO_DENY_VERSION}/cargo-deny-${CARGO_DENY_VERSION}-${ARCH}-unknown-linux-musl.tar.gz" \
 && tar -xzf /tmp/deny.tgz -C /tmp \
 && mv /tmp/cargo-deny-*/cargo-deny /usr/local/bin/ \
 && rm -rf /tmp/deny.tgz /tmp/cargo-deny-*
COPY deny.toml ./
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    cargo deny --locked check advisories

# The dashboard's unit-test binary alone, for the Settings pages below: the
# compile's own invocation again over the same cache, so nothing compiles
# again, and the one executable kept -- not compile's every test binary,
# which the gate frees before e2e-settings-page runs (gate-drop-tests-image).
FROM check AS settings-binary
RUN --mount=type=cache,id=meridian-core-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=meridian-core-target,target=/w/target \
    fresh-sources cargo test --workspace --locked --no-run --lib --test '*' \
      --message-format=json-render-diagnostics >/tmp/compiled.json \
 && exe=$(sed -n 's/.*"manifest_path":"[^"]*\/crates\/dashboard\/Cargo.toml".*"target":{"kind":\["lib"\].*"executable":"\([^"]*\)".*/\1/p' /tmp/compiled.json | head -1) \
 && test -n "$exe" \
 && cp "$exe" /settings-page \
 && rm /tmp/compiled.json

# A plugin's Settings pages served for a real browser (make e2e-settings-page):
# the dashboard's unit-test binary, whose ignored server
# (crates/dashboard/src/admin/tests/served.rs) stands up its own world in-process,
# on the runtime image so it serves the kit that image carries.
FROM ${RUNTIME_IMAGE} AS settings-page
COPY --from=settings-binary /settings-page /usr/local/bin/settings-page
ENTRYPOINT ["settings-page", "--ignored", "--exact", "admin::tests::served::serve_a_plugins_settings_pages_for_a_browser", "--nocapture"]
