# syntax=docker/dockerfile:1
#
# The one place the domain bindings are generated.
#
# Every version here is pinned, and pinned to what meridian-schema uses for the
# plugin-facing bindings. A contributor's host protoc at a different version
# produces subtly different output, the vendored file churns, and the diff stops
# being reviewable -- so the host is never asked to have one.
#
# Build with `make codegen`, which exports the result into crates/domain/src/.

ARG PROTOC_VERSION=29.3
ARG RUST_VERSION=1.90

# The tools CI keeps in GitHub's cache (tools/ci-tools.txt), given as the
# `fetched` build context there and empty here: protoc is copied from it
# where it is, and fetched otherwise; checked against its digest either way.
FROM scratch AS fetched

FROM debian:bookworm-slim AS protoc
ARG PROTOC_VERSION
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# protoc publishes aarch_64, not arm64, and no digest: these are the ones its
# release first served (tools/ci-tools.txt).
ARG PROTOC_SHA256_AMD64=3e866620c5be27664f3d2fa2d656b5f3e09b5152b42f1bedbf427b333e90021a
ARG PROTOC_SHA256_ARM64=6427349140e01f06e049e707a58709a4f221ae73ab9a0425bc4a00c8d0e1ab32
RUN --mount=type=bind,from=fetched,target=/fetched \
    case "${TARGETARCH}" in \
      amd64) PROTOC_ARCH=x86_64; SUM="${PROTOC_SHA256_AMD64}" ;; \
      arm64) PROTOC_ARCH=aarch_64; SUM="${PROTOC_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && file="protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip" \
 && { cp "/fetched/$file" /tmp/protoc.zip 2>/dev/null \
      || curl -fsSL --retry 6 --retry-all-errors --retry-delay 10 --retry-max-time 300 -o /tmp/protoc.zip \
           "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/$file"; } \
 && echo "${SUM}  /tmp/protoc.zip" | sha256sum -c - \
 && unzip -q /tmp/protoc.zip -d /usr/local \
 && chmod +x /usr/local/bin/protoc \
 && rm /tmp/protoc.zip \
 && protoc --version

FROM rust:${RUST_VERSION}-slim-bookworm AS rust-gen
COPY --from=protoc /usr/local/bin/protoc /usr/local/bin/protoc
COPY --from=protoc /usr/local/include/google /usr/local/include/google
WORKDIR /src
COPY codegen/Cargo.toml codegen/Cargo.lock codegen/
COPY codegen/src codegen/src
COPY proto/ proto/
# meridian-schema's protos at the pinned revision, a build context the Makefile
# names from Cargo.toml, so the import resolves against what the runtime links.
COPY --from=schema-proto . /schema-proto/
# The target cache has an id of its own: keyed by its path alone, it is the
# same cache as meridian-schema's codegen, whose binary cargo then found fresh
# and ran here in place of this one ("No such file or directory").
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=meridian-core-codegen-target,target=/src/codegen/target \
    cd codegen && cargo run --release --locked

# The book's transition table (decisions/035), generated from
# meridian-schema's boundaries/transitions.json at the pinned revision, a
# build context the Makefile names as it names the protos'.
FROM python:3.12-alpine AS transitions
COPY tools/generate_transitions.py /tools/generate_transitions.py
COPY --from=schema-boundaries transitions.json /schema-boundaries/transitions.json
RUN mkdir -p /out \
 && python3 /tools/generate_transitions.py --self-test \
 && python3 /tools/generate_transitions.py /schema-boundaries/transitions.json /out/transitions.rs

FROM scratch AS export
COPY --from=rust-gen /out/v1.rs /v1.rs
COPY --from=transitions /out/transitions.rs /transitions.rs
# The data dictionary (contract v26, W6.20): the boundaries' fields.json at
# the pinned revision, carried whole for dashboard__read_dictionary_entry.
COPY --from=schema-boundaries fields.json /fields.json
