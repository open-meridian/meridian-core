# syntax=docker/dockerfile:1
#
# The one place the domain bindings are generated.
#
# Every version here is pinned, and pinned to what meridian-schema uses for the
# plugin-facing bindings. A contributor's host protoc at a different version
# produces subtly different output, the vendored file churns, and the diff stops
# being reviewable -- so the host is never asked to have one.
#
# Build with `make codegen`, which exports the result into crates/domain/src/.

ARG PROTOC_VERSION=29.3
ARG RUST_VERSION=1.90

FROM debian:bookworm-slim AS protoc
ARG PROTOC_VERSION
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# protoc publishes aarch_64, not arm64.
RUN case "${TARGETARCH}" in \
      amd64) PROTOC_ARCH=x86_64 ;; \
      arm64) PROTOC_ARCH=aarch_64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/protoc.zip \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip" \
 && unzip -q /tmp/protoc.zip -d /usr/local \
 && chmod +x /usr/local/bin/protoc \
 && rm /tmp/protoc.zip \
 && protoc --version

FROM rust:${RUST_VERSION}-slim-bookworm AS rust-gen
COPY --from=protoc /usr/local/bin/protoc /usr/local/bin/protoc
COPY --from=protoc /usr/local/include/google /usr/local/include/google
WORKDIR /src
COPY codegen/Cargo.toml codegen/Cargo.lock codegen/
COPY codegen/src codegen/src
COPY proto/ proto/
# meridian-schema's protos at the pinned revision, a build context the Makefile
# names from Cargo.toml, so the import resolves against what the runtime links.
COPY --from=schema-proto . /schema-proto/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/codegen/target \
    cd codegen && cargo run --release --locked

FROM scratch AS export
COPY --from=rust-gen /out/v1.rs /v1.rs
