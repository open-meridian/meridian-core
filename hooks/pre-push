#!/usr/bin/env bash
# Pre-push gate: the fast one. CI on the pull request runs everything, and the
# merge queue is the only authority for main (accepted 2026-11-07, superseding
# ruling 1075's full local gate).
#
# Activate on a fresh clone with:  make install-hooks
# (sets core.hooksPath=hooks, so this actually fires)
#
# `make pre-push` runs lint, the build, the changed crates' unit tests and the
# stages the changed paths select (PRE_PUSH_MAP in the Makefile), and says
# which and why. `make ci-local` is still the whole gate, run by hand when CI
# is down; `make ci-stage STAGE=<x>` reproduces one CI job.
#
# --no-verify bypasses this. It is not recommended and settings.json denies it
# to agent sessions.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: running make pre-push"
if ! make pre-push; then
  echo
  echo "pre-push: BLOCKED -- make pre-push failed."
  echo "Fix it locally. Pushing red turns CI into a remote debugger."
  exit 1
fi
